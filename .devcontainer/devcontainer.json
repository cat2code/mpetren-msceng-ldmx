{
  "name": "LDMX",
  "image": "ldmx/pro:trunk",
  "runArgs": ["--platform=linux/amd64"],
  "workspaceFolder": "/workspaces/mpetren-msceng-ldmx",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/mpetren-msceng-ldmx,type=bind",
  "remoteEnv": {
    "PYTHONPATH": "/usr/local/python"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "workbench.colorTheme": "Dark Modern",
        "python.defaultInterpreterPath": "/workspaces/mpetren-msceng-ldmx/.venv-analysis/bin/python",
        "python.analysis.extraPaths": [
          "/usr/local/python"
        ],
        "python.autoComplete.extraPaths": [
          "/usr/local/python"
        ]
      }
    }
  },
  "postCreateCommand": "bash -lc 'apt-get update && apt-get install -y python3-venv python3-pip'"
}